<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDocumentRoot"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:orientation="vertical"
    android:background="@drawable/card_border_frame"
    android:clickable="true"
    android:focusable="true">

    <!-- Paper preview (White top sheet) -->
    <ImageView
        android:id="@+id/imgCardThumbnail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_paper_top"
        android:scaleType="fitXY"
        android:contentDescription="Miniatura do documento" />

    <!-- Bottom Dark Banner with TITLE -->
    <LinearLayout
        android:id="@+id/bannerCardBottom"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/card_banner_bg"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/lblCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="TITULO"
            android:textColor="@color/card_banner_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
